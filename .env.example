# Copy this file to .env (gitignored). It is read by
# asyncroscopy.agent.config.load_dotenv_if_present() and by `langgraph dev`.

# Which model the agent uses: ollama | openai | anthropic | google_genai | tango
ASYNCROSCOPY_AGENT_PROVIDER=ollama
# Model name; for provider=tango this is the LLM Tango device name.
ASYNCROSCOPY_AGENT_MODEL=gemma4:31b
# Examples: gpt-4o-mini (openai), claude-sonnet-4-5 (anthropic), asyncroscopy/llm/default (tango)

ASYNCROSCOPY_AGENT_MCP_URL=http://127.0.0.1:8000/mcp
# Comma-separated skills folders (relative paths resolve against the repo root).
ASYNCROSCOPY_AGENT_SKILLS_DIRS=skills

# API keys stay here or in your shell environment, never in configs/*.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Tango database used by provider=tango and by the notebooks.
# TANGO_HOST=localhost:9094

# Optional: LangSmith tracing for LangGraph Studio runs.
# LANGSMITH_API_KEY=
