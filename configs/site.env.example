# Addresses of the lab's machines. They are kept out of git.
#
# Copy this file to configs/site.env (git ignores it) and fill in the values.
# The team keeps the filled-in file somewhere private; ask for a copy.
# Configs refer to these names as "${NAME}"; an environment variable with the
# same name overrides the file. Notebooks read the same names from the environment.

# Spectra 300 PC: Tango database, Tiled, AutoScript and the CEOS corrector.
ASYNCROSCOPY_MICROSCOPE_HOST=

# Gatan PC that runs the EELS server (configs/Spectra300.yaml, configs/Spectra300eels.yaml).
ASYNCROSCOPY_GATAN_HOST=

# Talos control server (configs/covalent-talos.yaml).
ASYNCROSCOPY_TALOS_HOST=

# F200 control server (configs/covalent-F200.yaml).
ASYNCROSCOPY_F200_HOST=

# Machine that runs the segmentation device's Tango database (configs/Segmentation.yaml).
ASYNCROSCOPY_SEGMENTATION_HOST=
